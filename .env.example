# ============================================================
# English Practice Hub - production example
# Copy to .env and replace every CHANGE_ME value.
# ============================================================
APP_ENV=production
LOG_LEVEL=INFO

# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# PostgreSQL
DATABASE_URL=postgresql://english_app:CHANGE_ME@postgres:5432/english_db

# First administrator. Used only when the account does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123

# Demo accounts should normally remain disabled in production.
SEED_DEMO_USERS=false

# Reverse proxy / HTTPS
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true
FORCE_HTTPS=false
# Comma-separated hostnames. Leave empty only while configuring.
ALLOWED_HOSTS=

# Login protection
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW_SECONDS=900

# Uploads and Gunicorn
MAX_UPLOAD_BYTES=10485760
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
RUN_STARTUP_QA=0

# Optional tunnel deployment from the existing compose file
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
