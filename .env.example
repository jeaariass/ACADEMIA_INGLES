# ============================================================
# English Practice Hub - variables del stack VPS (/srv/stacks/academia/.env, permisos 600)
# Copiar a .env y reemplazar cada CHANGE_ME.
# ============================================================
APP_ENV=production
LOG_LEVEL=INFO

# Version de imagen a desplegar (commit corto subido por build-and-push.ps1).
TAG=latest

# DB_* los escribe /srv/scripts/nueva-bd-app.sh academia la primera vez.
# No editar a mano salvo rotacion de clave (y actualizar tambien en Postgres).
DB_HOST=db-postgis
DB_PORT=5432
DB_NAME=academia
DB_USER=app_academia
DB_PASSWORD=CHANGE_ME

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Primer administrador. Solo se usa si la cuenta no existe todavia: cambiar este
# valor despues del primer arranque NO rota la clave de un admin ya creado
# (ver app/seed.py:ensure_user) — cambiarla desde la propia app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Las cuentas demo deben quedar deshabilitadas en produccion.
SEED_DEMO_USERS=false

# nginx del host es el unico proxy; TRUST_PROXY activa ProxyFix con 1 salto.
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true
FORCE_HTTPS=false
# /healthz y /readyz quedan exentos de esta validacion (ver app/security.py);
# no es necesario agregar 127.0.0.1 ni localhost aqui.
ALLOWED_HOSTS=academia.179-197-81-33.sslip.io

# Proteccion de login
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW_SECONDS=900

# Subidas y Gunicorn
MAX_UPLOAD_BYTES=10485760
GUNICORN_WORKERS=2
# Ollama corre en CPU; una historia IA puede tardar mas de 120s. nginx del VPS
# permite hasta 300s de proxy_read_timeout, dejar margen por debajo de eso.
GUNICORN_TIMEOUT=180
RUN_STARTUP_QA=0

# LLM compartido del VPS (stack "ollama" en la red ai_net). Dejar OLLAMA_HOST vacio
# para desactivar el generador de historias con IA.
OLLAMA_HOST=http://ai-ollama:11434
OLLAMA_MODEL=llama3.2:3b
