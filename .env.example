# ===========================================================================
#  INGLES - English Practice Hub — variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real a git.
# ===========================================================================

# --- Base de datos (Postgres compartido de infra) ---
# Host "postgres" = contenedor de infra en la red shared-net.
# Crea la BD antes del primer deploy:
#   docker exec -it postgres psql -U jesus -c "CREATE DATABASE english_db;"
DATABASE_URL=postgresql://jesus:CLAVE_POSTGRES@postgres:5432/english_db?connection_limit=5

# --- Flask ---
FLASK_SECRET_KEY=cambiar-esta-clave-super-segura

# --- Usuarios iniciales (se crean al arrancar si no existen) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123*
STUDENT1_USERNAME=estudiante1
STUDENT1_PASSWORD=Estudiante123*
STUDENT2_USERNAME=estudiante2
STUDENT2_PASSWORD=Estudiante123*

# --- ngrok Tunnel ---
# Authtoken: ngrok.com -> dashboard -> Your Authtoken
NGROK_AUTHTOKEN=pegar-authtoken-aqui
# Dominio fijo: ngrok.com -> dashboard -> Domains -> New Domain
NGROK_DOMAIN=tu-dominio.ngrok-free.app
